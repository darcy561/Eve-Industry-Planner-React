        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Now",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Live bytes across every bucket. Deleted objects still occupying space are counted separately, under reclaimable.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "mappings": [],
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(SeaweedFS_s3_bucket_size_bytes)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Stored",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
