{
  "annotations": {
    "list": []
  },
  "description": "SeaweedFS as the stack uses it: the S3 gateway the application stores through, and the volume server underneath it. Storage problems surface here before they surface anywhere else.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
