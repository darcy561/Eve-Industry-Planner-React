    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Volumes in use against the maximum this server will allocate. SeaweedFS stops accepting writes when it can no longer create a volume.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "mappings": [],
          "max": 1,
          "min": 0,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "id": 103,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(SeaweedFS_volumeServer_volumes{collection=\"\"}) / clamp_min(max(SeaweedFS_volumeServer_max_volumes), 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Volume slots used",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Space held by deleted objects, recovered when the volume is next vacuumed.",
